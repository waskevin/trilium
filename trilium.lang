# Multilingual file for TOS 7 Docker application. All 14 languages are REQUIRED.

[en-us]
name = "Trilium Notes"
auth = "waskevin"
descript = "Trilium Notes is a hierarchical note-taking application for building a personal knowledge base on your TNAS. Notes are arranged as a tree and support rich text, code blocks, images, diagrams, relations and canvases."
release_note = "1. Initial release."
important = "Open the web UI once to finish the initial setup and set an access password. Docker Engine must be installed and enabled from the TOS App Center."

[zh-cn]
name = "Trilium Notes"
auth = "waskevin"
descript = "Trilium Notes 是层级式笔记应用，可在 TNAS 上构建个人知识库。笔记以树状结构组织，支持富文本、代码块、图片、关系图与画布。"
release_note = "1. Initial release."
important = "首次打开网页界面时请完成初始化并设置访问密码。需先在应用中心安装并启用 DockerEngine。"

